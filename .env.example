EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Crash reporting (optional — unset means Sentry is a no-op, see app/_layout.tsx).
# Create a React Native project at sentry.io and paste its DSN here.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only, for source-map upload by the @sentry/react-native config
# plugin. Set these as EAS secrets, not in .env.local:
#   SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN
