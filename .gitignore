# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# No trailing slash: in a git worktree, node_modules is a *symlink* back to the
# root install, and "node_modules/" only matches directories — so the symlink
# showed up as untracked and committable. This form matches both.
node_modules

# Expo
.expo/
dist/
dist-ci/
web-build/
expo-env.d.ts

# Edition-email preview output (render-email-fixtures.ts); CI uploads it as an
# artifact instead of committing it.
preview-out/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# design-reference screenshots (inspiration only — not shipped)
/screenshots

# git worktrees created inside the repo (Claude Code's EnterWorktree, etc.)
/.claude/worktrees/

# personal Claude Code permissions — machine-specific, never shared
/.claude/settings.local.json

# deno check writes this; `supabase functions deploy` does not use it
deno.lock
