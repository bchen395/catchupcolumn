{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "staging": {
      "extends": "production",
      "channel": "staging",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
